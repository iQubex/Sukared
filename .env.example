# Luavex backend
NODE_ENV=production
PORT=3000
FRONTEND_ORIGIN=https://luavex.pntr.dev
LUAVEX_API_BASE=https://backend-luavex.up.railway.app

# Discord OAuth2 (OAuth2 > General)
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://backend-luavex.up.railway.app/auth/discord/callback
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TTL_MS=43200000

# Internal rollback controls (keep disabled in production).
SUKARED_LOCAL_DEVELOPMENT=0
SUKARED_HELL_ENABLED=0

# Existing service limits
SUKARED_BUILD_CONCURRENCY=2
SUKARED_MAX_QUEUE_DEPTH=8
SUKARED_BUILD_TIMEOUT_MS=30000
SUKARED_WORKER_MEMORY_MB=512
